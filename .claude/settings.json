{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 15,
            "statusMessage": "Cold-start: 引き継ぎ書とルール索引を読み込み中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.sh\"",
            "timeout": 120,
            "statusMessage": "pre-commit gate: gitleaks staged scan..."
          }
        ]
      }
    ]
  }
}
